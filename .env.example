# RelaySMS relay configuration. Copy to .env and fill in real values. Never commit .env.
# Placeholder values only — nothing in this file is a real credential.

# --- Docker Compose deployment (infra/compose.yaml) ---------------------------------------
# Public DNS name of the relay. Caddy obtains a TLS certificate for it.
RELAY_DOMAIN=relay.example.com
# Database password. Letters and digits only (it is placed inside a connection URL).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Running the relay directly (npm start), without Compose ------------------------------
# Compose sets these itself and ignores the values here.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# PostgreSQL connection string.
DATABASE_URL=postgres://relaysms:CHANGE_ME@db:5432/relaysms
# Number of reverse proxies in front of the relay (1 when behind the bundled Caddy).
TRUST_PROXY=1

# --- Relay behaviour (both ways of running) -----------------------------------------------
# Recommended on a public server. If set (16+ characters), a phone must present this code to
# register with the relay; type the same code into the pairing screen of each phone.
# Generate one with: openssl rand -hex 16
REGISTRATION_CODE=

# Pairing codes: lifetime and wrong-guess limit.
PAIRING_TTL_SECONDS=300
PAIRING_MAX_FAILED_ATTEMPTS=5

# Undelivered ciphertext is deleted after this many hours.
MESSAGE_TTL_HOURS=72
# Largest accepted ciphertext, in bytes.
MAX_CIPHERTEXT_BYTES=131072
# Undelivered messages allowed per recipient.
MAX_PENDING_PER_DEVICE=500

# Rate limits.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_REGISTRATION_MAX=10
RATE_LIMIT_PAIRING_MAX=20

LOG_LEVEL=info

# --- Shared databases and serverless platforms (see docs/VERCEL.md) ---

# Schema that holds every RelaySMS table. Must not be "public".
DATABASE_SCHEMA=relaysms
# Optional PEM certificate authority when DATABASE_URL uses sslmode=verify-full.
DATABASE_CA_CERT=
# Connections per process (the Vercel entry point uses 2).
DB_POOL_MAX=10
# websocket (long-running server) or poll (serverless; the Vercel entry point sets this itself).
REALTIME=websocket
POLL_INTERVAL_SECONDS=10
# Enables GET /internal/cron/expire for scheduled clean-up. 16+ characters when set.
CRON_SECRET=
