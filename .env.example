# RelaySMS relay configuration. Copy to .env and fill in real values. Never commit .env.
# Placeholder values only — nothing in this file is a real credential.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgres://relaysms:CHANGE_ME@db:5432/relaysms

# Number of reverse proxies in front of the relay (1 when behind the bundled Caddy).
TRUST_PROXY=1

# Optional. If set (16+ characters), a phone must present this code to register with the relay.
REGISTRATION_CODE=

# Pairing codes: lifetime and wrong-guess limit.
PAIRING_TTL_SECONDS=300
PAIRING_MAX_FAILED_ATTEMPTS=5

# Undelivered ciphertext is deleted after this many hours.
MESSAGE_TTL_HOURS=72
# Largest accepted ciphertext, in bytes.
MAX_CIPHERTEXT_BYTES=131072
# Undelivered messages allowed per recipient.
MAX_PENDING_PER_DEVICE=500

# Rate limits.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_REGISTRATION_MAX=10
RATE_LIMIT_PAIRING_MAX=20

LOG_LEVEL=info
