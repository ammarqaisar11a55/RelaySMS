<?xml version="1.0" encoding="utf-8"?>
<!-- Release: TLS only, system trust anchors, no user-installed CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
